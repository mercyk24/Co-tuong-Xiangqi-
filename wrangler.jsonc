// Cấu hình Cloudflare Workers cho điểm hẹn riêng (và bản sao trang web).
// Cài: npm i -D wrangler   ·   chạy thử trên máy: npx wrangler dev   ·   đưa lên: npx wrangler deploy
// Xem hướng dẫn đầy đủ trong docs/MO-RONG.md.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "co-tuong",
  "main": "server/worker.mjs",
  "compatibility_date": "2025-10-01",
  // Trang web (bản dựng trong dist/). Đường /peerjs và /health không phải tệp nên đi vào worker.
  "assets": { "directory": "./dist", "binding": "ASSETS" },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  // Durable Object dùng SQLite: có trong gói miễn phí của Cloudflare
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "vars": {
    // Chỉ cho trang của app dùng điểm hẹn (cách nhau bởi dấu phẩy). Để trống = cho mọi nơi.
    "ALLOWED_ORIGINS": "https://mercyk24.github.io,https://co-tuong.cotuong-mercy.workers.dev,http://localhost:4173"
  },
  // Giới hạn mở kết nối theo địa chỉ IP: 120 lần mỗi phút (xem server/worker.mjs). Có trong gói miễn phí.
  "ratelimits": [{ "name": "CONN_LIMIT", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } }],
  // Nhật ký: chỉ ghi lỗi, không ghi từng lượt truy cập (nhật ký lượt truy cập chứa địa chỉ IP, địa chỉ kết nối kèm mã phòng
  // và thẻ phiên). Thu thập ít nhất có thể theo Luật Bảo vệ dữ liệu cá nhân. Số lượt truy cập vẫn xem được ở mục Metrics.
  "observability": { "enabled": true, "head_sampling_rate": 1, "logs": { "invocation_logs": false } }
}
